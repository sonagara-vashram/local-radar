# MongoDB Settings
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=LOCAL_RADAR

# Rate Limiting Settings
RATE_LIMIT_CALLS=10000
RATE_LIMIT_PERIOD=600
BLOCK_DURATION=6000
PERMANENT_BLOCK_THRESHOULD=30
PERMANENT_BLOCK_DURATION=864000

# Redis Settings (Upstash Redis as default)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_SSL=False

# JWT Settings
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_TIME_MINUTES=30
JWT_REFRESH_EXPIRATION_TIME_MINUTES=1440

# Secure API
SECURE_API=your_secure_api_key_here

# CORS Settings (Comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000